<canvas id="tech-bg" aria-hidden="true"></canvas>
<style>
#tech-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
@media (prefers-color-scheme: dark) { #tech-bg { opacity: 0.55; } }
</style>
<script>
(function () {
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) return;
  var c = document.getElementById('tech-bg');
  var ctx = c.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W, H, pts = [];
  var mouse = { x: null, y: null, speed: 0 };

  function init() {
    W = window.innerWidth; H = window.innerHeight;
    c.width = W * DPR; c.height = H * DPR;
    c.style.width = W + 'px'; c.style.height = H + 'px';
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    var n = Math.max(36, Math.min(90, Math.round(W * H / 22000)));
    pts = [];
    var i;
    for (i = 0; i < n; i++) {
      pts.push({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .35, vy: (Math.random() - .5) * .35 });
    }
  }
  window.addEventListener('resize', init);
  init();

  function moveMouse(x, y) {
    if (mouse.x !== null) {
      var d = Math.hypot(x - mouse.x, y - mouse.y);
      mouse.speed = Math.max(mouse.speed, d);
    }
    mouse.x = x; mouse.y = y;
  }
  window.addEventListener('mousemove', function (e) { moveMouse(e.clientX, e.clientY); });
  window.addEventListener('touchmove', function (e) {
    if (e.touches.length) { moveMouse(e.touches[0].clientX, e.touches[0].clientY); }
  }, { passive: true });
  window.addEventListener('mouseleave', function () { mouse.x = null; mouse.y = null; });

  window.addEventListener('click', function (e) {
    var i;
    for (i = 0; i < pts.length; i++) {
      var p = pts[i];
      var dx = p.x - e.clientX, dy = p.y - e.clientY;
      var d = Math.hypot(dx, dy);
      if (d < 240 && d > 0.5) {
        var f = 2.4 - d / 100;
        p.vx += dx / d * f; p.vy += dy / d * f;
      }
    }
  });

  var LINK = 140;
  function step() {
    ctx.clearRect(0, 0, W, H);
    var i, j, p, q;
    for (i = 0; i < pts.length; i++) {
      p = pts[i];
      p.vx += (Math.sin(p.y * 0.0016) + (Math.random() - .5) * .012) * 0.006;
      p.vy += (Math.cos(p.x * 0.0016) + (Math.random() - .5) * .012) * 0.006;
      if (mouse.x !== null) {
        var mdx = mouse.x - p.x, mdy = mouse.y - p.y;
        var md = Math.hypot(mdx, mdy);
        if (md < 200 && md > 1) {
          var f = mouse.speed > 14 ? -0.05 : 0.022;
          p.vx += mdx / md * f; p.vy += mdy / md * f;
        }
      }
      p.vx *= 0.985; p.vy *= 0.985;
      p.x += p.vx; p.y += p.vy;
      if (p.x < -20) p.x = W + 20;
      if (p.x > W + 20) p.x = -20;
      if (p.y < -20) p.y = H + 20;
      if (p.y > H + 20) p.y = -20;
    }
    ctx.lineWidth = 1;
    for (i = 0; i < pts.length; i++) {
      p = pts[i];
      for (j = i + 1; j < pts.length; j++) {
        q = pts[j];
        var dx2 = p.x - q.x, dy2 = p.y - q.y, d2 = dx2 * dx2 + dy2 * dy2;
        if (d2 < LINK * LINK) {
          var a = (1 - Math.sqrt(d2) / LINK) * 0.5;
          ctx.strokeStyle = 'rgba(0,170,220,' + a.toFixed(3) + ')';
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
        }
      }
      if (mouse.x !== null) {
        var mx = p.x - mouse.x, my = p.y - mouse.y, md2 = mx * mx + my * my;
        if (md2 < 32400) {
          var a2 = (1 - Math.sqrt(md2) / 180) * 0.6;
          ctx.strokeStyle = 'rgba(43,124,255,' + a2.toFixed(3) + ')';
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
        }
      }
    }
    ctx.fillStyle = 'rgba(0,190,240,0.55)';
    for (i = 0; i < pts.length; i++) {
      p = pts[i];
      ctx.beginPath(); ctx.arc(p.x, p.y, 1.4, 0, 6.283); ctx.fill();
    }
    mouse.speed *= 0.9;
    requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
})();
</script>
